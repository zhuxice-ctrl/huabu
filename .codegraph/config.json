{
  "project_size": "large",
  "level": "l2",
  "context_strategy": "L2-semantic-codegraph",
  "include": [
    "src/**"
  ],
  "exclude": [
    ".git",
    "node_modules",
    ".venv",
    "venv",
    "dist",
    "build",
    "__pycache__",
    ".next",
    ".turbo",
    "coverage",
    "target",
    "src-tauri/target",
    "src/app/core/main/file/folder-item/paste-target.spec.mjs",
    "src/app/core/main/mark/mark-view-mode.spec.mjs",
    "src/lib/vector-document-key.spec.mjs"
  ],
  "languages": [
    "typescript",
    "javascript"
  ],
  "test_patterns": [
    "tests",
    "__tests__",
    "*.test.*",
    "*.spec.*"
  ],
  "supported_queries": [
  "summary",
  "find_definition",
  "find_importers",
  "tests_for",
  "summarize_file",
  "make_context",
  "capabilities",
  "find_references",
  "callers",
  "callees",
  "impact",
  "slice",
  "expand"
]
}
