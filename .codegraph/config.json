{
  "project_size": "large",
  "level": "l2",
  "context_strategy": "L2-semantic-codegraph",
  "include": [
  "."
],
  "exclude": [
    ".git",
    "node_modules",
    ".venv",
    "venv",
    "dist",
    "build",
    "__pycache__",
    ".next",
    ".turbo",
    "coverage"
  ],
  "languages": [],
  "test_patterns": [
    "tests",
    "__tests__",
    "*.test.*",
    "*.spec.*"
  ],
  "supported_queries": [
  "summary",
  "find_definition",
  "find_importers",
  "tests_for",
  "summarize_file",
  "make_context",
  "capabilities",
  "find_references",
  "callers",
  "callees",
  "impact",
  "slice",
  "expand"
]
}
